{
  "name": "hono-worker-template",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, type-safe Cloudflare Workers starter built with Hono and Effect",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "pnpm run cf-typegen",
    "deploy": "wrangler deploy --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "effect": "^4.0.0-rc.112",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
