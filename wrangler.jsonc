{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-worker-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },

  // Non-secret configuration with deployed defaults. Values can be overridden
  // locally with a `.env` file (see `.env.example`).
  "vars": {
    "API_MOTD": "Hello world!"
  }

  // Node.js compatibility is enabled by default at this compatibility date
  // (2026-08-04 or later); add "compatibility_flags": ["no_nodejs_compat"]
  // to opt out.
  //
  // Uncomment and configure the bindings you need, then run `npm run cf-typegen`
  // to regenerate `worker-configuration.d.ts` (the `CloudflareBindings` interface).
  //
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  //
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  //
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  //   }
  // ],
  //
  // "ai": {
  //   "binding": "AI"
  // }
}
