# Local development values, loaded automatically by `wrangler dev`.
# Copy this file to `.env` (gitignored), then run `npm run cf-typegen`
# so the values show up typed on `CloudflareBindings`.

# Overrides the deployed default from `vars` in wrangler.jsonc.
API_MOTD="Hello world!"

# Secrets never go in wrangler.jsonc. Locally they live here; in production
# set them with: npx wrangler secret put API_SECRET_KEY
API_SECRET_KEY="dev-only-secret"
